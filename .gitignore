node_modules/
# dist/ is TRACKED on purpose: a global git install gets no devDependencies,
# so `tsc` isn't there to build it. CI fails if it drifts from src/.
# public/panel.js is tracked for the same reason (no esbuild, no react at
# install time). CI fails if it drifts from panel/src.
public/demo-data.js
public/assets/
# Baked into the Worker by scripts/build-worker-assets.mjs; same rule as
# demo-data.js — a build output, regenerated by `npm run build`.
worker/src/panel-assets.ts
test/.tmp-worker/
test/.tmp-home/
test/.tmp-smoke/
test/.tmp-e2e/
test/.tmp-single/
test/.tmp-single2/
test/.tmp-lan/
test/.tmp-lan2/

