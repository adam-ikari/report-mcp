node_modules/
# dist/ is TRACKED on purpose: a global git install gets no devDependencies,
# so `tsc` isn't there to build it. CI fails if it drifts from src/.
# vendor/am/am.mjs is tracked for a different reason — it is upstream's
# generated bundle, pinned by sha256 in vendor/am/manifest.json and gated by
# scripts/check-vendor.mjs. Never edit it.
test/.tmp-*/
*.log
.DS_Store

# VitePress docs site — node_modules and build output.
docs/node_modules/
docs/.vitepress/dist/
docs/.vitepress/cache/

# Example report pages under docs/public/reports/ ARE tracked: they are the
# rendered evidence that the vendored renderer works, regenerated and compared
# by scripts/render-samples.mjs --check.

# editor local tooling state
.qoder/
