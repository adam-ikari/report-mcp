{
  "name": "report-mcp",
  "version": "0.4.0",
  "description": "Milestone briefing MCP: the agent submits an answer-me-with-html draft, the tool renders it to a self-contained HTML report and a local host serves it as a link.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "report-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "vendor"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node test/run.mjs",
    "start": "node dist/index.js",
    "serve": "node dist/index.js serve",
    "samples": "node scripts/render-samples.mjs",
    "docs:dev": "npm run samples && npm --prefix docs run dev",
    "docs:build": "npm run samples && npm --prefix docs run build",
    "docs:preview": "npm --prefix docs run preview",
    "prepare": "node scripts/check-vendor.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
