{
  "name": "report-mcp",
  "version": "0.3.1",
  "description": "One-way agent -> human reporting MCP: progress, status, logs and structured results, persisted as JSONL and streamed to a local web panel.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "report-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "public"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-demo.mjs",
    "demo": "node scripts/build-demo.mjs",
    "watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node test/run.mjs",
    "start": "node dist/index.js",
    "docs:stage": "node scripts/stage-panel.mjs",
    "docs:dev": "npm run docs:stage && npm --prefix docs run dev",
    "docs:build": "npm run docs:stage && npm --prefix docs run build",
    "docs:preview": "npm --prefix docs run preview",
    "prepare": "node scripts/build-demo.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.6.0"
  }
}
